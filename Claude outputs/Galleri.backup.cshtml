@using Umbraco.Cms.Core.Models;
@using Umbraco.Cms.Web.Common.PublishedModels;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
	Layout = "layout.cshtml";

	var rubrik = Model.Value<string>("rubrik");
	var ingress = Model.Value<string>("ingress");
	var bilder = Model.Value<IEnumerable<MediaWithCrops>>("bilder") ?? Enumerable.Empty<MediaWithCrops>();
}

<article class="galleri">
	<section class="hero">
		<div class="hero-text">
			<h1>@(string.IsNullOrWhiteSpace(rubrik) ? Model.Name : rubrik)</h1>

			@if (!string.IsNullOrWhiteSpace(ingress))
			{
				<p class="galleri__ingress">@ingress</p>

			}
		</div>
	</section>

	@if(bilder.Any())
	{
		<ul class="galleri__grid">
			@foreach (var bild in bilder)
			{
				<li>
					<a href="@bild.MediaUrl()">
						<img src="@bild.GetCropUrl(width: 600, height: 400)"
							alt="@bild.Name" loading="lazy" />
					</a>
				</li>
			}
		</ul>
	}
	else
	{
		<p>Inga bilder ännu.</p>
	}
</article>