@using System.Globalization
@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Event>

@{
    Layout = "layout.cshtml";

    var namn = Model.Value<string>("namn");
    var beskrivning = Model.Value<string>("beskrivning");
    var datum = Model.Value<DateTime?>("datum");
    var bild = Model.Value<MediaWithCrops>("bild");
    // Mediabild (webp, flera storlekar) – annars standardbilden i wwwroot/images
    var bildInfo = CafeBlixten.Helpers.Bilder.FranMedia(bild, 1200)
        ?? CafeBlixten.Helpers.Bilder.Standard("cafe-blixten-livemusik", "Mysig cafékväll med fika och livemusik");
    var aktuellt = Model.Parent;
    var svenskKultur = CultureInfo.GetCultureInfo("sv-SE");

    // Varning om evenemanget ligger när caféet har stängt
    var kontaktsida = Model.Root().Children().FirstOrDefault(x => x.ContentType.Alias == "oppettiderKontakt");
    var sluttid = Model.Value<string>("sluttid");
    var varning = datum.HasValue
        ? CafeBlixten.Helpers.Oppettider.EvenemangVarning(kontaktsida, datum.Value, CafeBlixten.Helpers.Oppettider.NuISverige(), sluttid)
        : null;


}

<article class="news-detail" aria-labelledby="news-detail-title">
    <a class="news-detail__back" href="@(aktuellt?.Url() ?? "/")">
        &larr; Tillbaka till Aktuellt
    </a>

    <div class="news-detail__content">
        <span class="news-detail__label">Evenemang</span>

        <h1 id="news-detail-title">
            @(string.IsNullOrWhiteSpace(namn) ? Model.Name : namn)
        </h1>

        @if (datum.HasValue)
        {
            <time class="news-detail__date"
                  datetime="@datum.Value.ToString("yyyy-MM-ddTHH:mm")">
                @datum.Value.ToString("d MMMM yyyy", svenskKultur), @CafeBlixten.Helpers.Oppettider.Klockslag(datum.Value, sluttid)
            </time>
        }

        @if (varning != null)
        {
            <p class="news-detail__varning">
                @varning
                @if (kontaktsida != null)
                {
                    <a href="@kontaktsida.Url()">Se öppettider</a>
                }
            </p>
        }

        <img class="news-detail__image" src="@bildInfo.Src" srcset="@bildInfo.SrcSet" sizes="(max-width: 900px) 100vw, 800px" width="@bildInfo.Bredd" height="@bildInfo.Hojd" alt="" fetchpriority="high" />

        @if (!string.IsNullOrWhiteSpace(beskrivning))
        {
            <p class="news-detail__description">@beskrivning</p>
        }
    </div>
</article>