@using System.Linq
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Meny>

@{
  Layout = "layout.cshtml";

  var kategorier = Model.Value<BlockListModel>("kategorier");
}

<section class="menu-page" aria-labelledby="menu-page-title">
  <section class="hero">
    <div class="hero-text">
      <h1 id="menu-page-title">Meny</h1>
      <p class="hero-ingress">
        Något gott för varje stund – från nybryggt kaffe till lunch och fika.
      </p>
    </div>
  </section>

  @if (kategorier != null && kategorier.Any())
  {
    for (var i = 0; i < kategorier.Count; i++)
    {
      var kategori = kategorier[i].Content;

      var kategoriNamn = kategori.Value<string>("namn");
      var kategoriBild = kategori.Value<MediaWithCrops>("bild");
      var produkter = kategori.Value<BlockListModel>("produkter");

      <section class="menu-page__category" aria-labelledby="meny-kategori-@i">
        <h2 id="meny-kategori-@i">@kategoriNamn</h2>

        @if (kategoriBild != null)
        {
          <img class="menu-page__category-image" src="@kategoriBild.Url()" alt="" loading="lazy" />
        }

        @if (produkter != null && produkter.Any())
        {
          <ul class="menu-page__list">
            @foreach (var produktBlock in produkter)
            {
              var produkt = produktBlock.Content;
              var namn = produkt.Value<string>("namn");
              var pris = produkt.Value<decimal?>("pris");
              var beskrivning = produkt.Value<string>("beskrivning");

              <li class="menu-page__item">
                <div class="menu-page__item-header">
                  <h3 class="menu-page__item-name">@namn</h3>

                  @if (pris.HasValue)
                  {
                    <span class="menu-page__item-price">
                      @pris.Value.ToString("0.##")&nbsp;kr
                    </span>
                  }
                </div>

                @if (!string.IsNullOrWhiteSpace(beskrivning))
                {
                  <p class="menu-page__item-description">
                    @beskrivning
                  </p>
                }
              </li>
            }
          </ul>
        }
      </section>
    }
  }
  else
  {
    <p>Menyn uppdateras snart.</p>
  }
</section>