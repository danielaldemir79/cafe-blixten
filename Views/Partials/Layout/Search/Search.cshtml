@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

<div id="Search" class="search" role="dialog" aria-modal="true" aria-label="Sök på webbplatsen">
  <div class="search-overlay"></div>

  <div class="close-button-container">
    <button id="CloseSearch" class="close-button" aria-label="Stäng sökfältet">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
      </svg>
    </button>
  </div>

  <div class="search-container">
    <search class="search-form-container">
      <form class="search-form" action="/sok" method="get">
        <label for="SearchInput" class="visually-hidden">Sök på webbplatsen</label>
        <input id="SearchInput"
               class="search-input"
               type="search"
               name="q"
               placeholder="Sök efter meny, evenemang, nyheter…"
               autocomplete="off"
               aria-describedby="SearchStatus"
               required />
        <button type="submit" class="search-submit" aria-label="Sök">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </button>
      </form>

      <div class="search-results-panel">
        <p id="SearchStatus" class="search-status" role="status" aria-live="polite"></p>
        <ul id="SearchResults" class="search-results"></ul>
      </div>
    </search>
  </div>
</div>