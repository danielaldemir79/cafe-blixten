@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.VeckansFika>

@{
    Layout = "layout.cshtml";

    var namn = Model.Value<string>("namn");
    var beskrivning = Model.Value<string>("beskrivning");
    var pris = Model.Value<decimal?>("pris");
    var bild = Model.Value<MediaWithCrops>("bild");
    var bildUrl = bild?.Url();
    var bildAlt = bild?.Name;
    var aktuellt = Model.Parent;

    if (string.IsNullOrWhiteSpace(bildUrl))
    {
      bildUrl = "/images/cafe-blixten-kanelbullar.png";
      bildAlt = "Kaffe och nybakade kanelbullar";
    }
}

<article class="news-detail" aria-labelledby="news-detail-title">
    <a class="news-detail__back" href="@(aktuellt?.Url() ?? "/")">
        &larr; Tillbaka till Aktuellt
    </a>

    <div class="news-detail__content">
        <span class="news-detail__label">Veckans fika</span>

        <h1 id="news-detail-title">
            @(string.IsNullOrWhiteSpace(namn) ? Model.Name : namn)
        </h1>

        <img class="news-detail__image"
             src="@bildUrl"
             alt="@bildAlt" />

        @if (!string.IsNullOrWhiteSpace(beskrivning))
        {
            <p class="news-detail__description">@beskrivning</p>
        }

        @if (pris.HasValue)
        {
            <p class="news-detail__price">
                @pris.Value.ToString("0.##") kr
            </p>
        }
    </div>
</article>