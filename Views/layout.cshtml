@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  Layout = null;

  var seoTitel = Model.Value<string>("seoTitel");
  var metabeskrivning = Model.Value<string>("metabeskrivning");

  var sidtitel = string.IsNullOrWhiteSpace(seoTitel)
      ? Model.Name
      : seoTitel.Trim();
}

<!DOCTYPE html>
<html lang="sv">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@sidtitel | Café Blixten</title>

  @if (!string.IsNullOrWhiteSpace(metabeskrivning))
  {
    <meta name="description" content="@metabeskrivning.Trim()" />
  }

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  @* Typsnitten ligger i wwwroot/fonts (se Styles/base/_fonts.scss). Förladdas så att
     webbläsaren inte behöver vänta på CSS:en innan den hittar dem. *@
  <link rel="preload" href="/fonts/roboto-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fira-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/main.css" asp-append-version="true" />

  @* Minifierad version byggs med "npm run build:js" *@
  <script src="/js/main.min.js" asp-append-version="true" defer></script>
</head>

<body>
  <a class="skip-link" href="#Main">Hoppa till innehållet</a>

  @* Ordningen i HTML:en styr tab-ordningen: sök (huvud-headern) → navigationen → innehållet.
     Placeringen på skärmen styrs av grid-areorna i Styles/layout/_page.scss. *@
  @await Html.PartialAsync("Layout/Main/Header/Header")

  @await Html.PartialAsync("Layout/Sidebar/Sidebar")

  <main id="Main" tabindex="-1">
    <header id="Breadcrumbs">
      @await Html.PartialAsync("Layout/Main/Header/Breadcrumbs")
    </header>
    <div class="main-container">
      <div class="main-content">
        @RenderBody()
      </div>
      @await Html.PartialAsync("Layout/Main/Footer/Footer")
    </div>
  </main>
  @await Html.PartialAsync("Layout/Search/Search")
  @await Html.PartialAsync("Layout/CookieBanner/CookieBanner")
</body>
</html>
