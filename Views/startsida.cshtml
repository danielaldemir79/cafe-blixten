@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "layout.cshtml";

	var svenska = new System.Globalization.CultureInfo("sv-SE");

	// ---- Sidor under Hem som startsidan länkar till ----
	var undersidor = Model.Children().ToList();
	var menySida = undersidor.FirstOrDefault(x => x.ContentType.Alias == "meny");
	var aktuelltSida = undersidor.FirstOrDefault(x => x.ContentType.Alias == "aktuellt");
	var hittaOss = undersidor.FirstOrDefault(x => x.ContentType.Alias == "hittaOss");
	var kontaktSida = undersidor.FirstOrDefault(x => x.ContentType.Alias == "oppettiderKontakt");

	// ---- Hero: fält direkt på Startsida-dokumenttypen ----
	var heroRubrik = Model.Value<string>("heroRubrik");
	var heroIngress = Model.Value<string>("heroIngress");
	var heroBild = Model.Value<MediaWithCrops>("heroBild");
	// Bild vald i Umbraco går först. Annars används standardbilden i wwwroot/images,
	// så att alla får samma hero-bild direkt efter pull/import.
	var heroBildUrl = heroBild?.GetCropUrl(width: 900);
	var heroBildAlt = heroBild?.Name;
	if (string.IsNullOrWhiteSpace(heroBildUrl))
	{
		heroBildUrl = "/images/pexels-nathanjhilton-30173526.jpg";
		heroBildAlt = "Kafé med bardisk där gäster beställer vid kassan";
	}
	// Fungerar oavsett om Multi URL Picker har max 1 länk eller fler
	var heroKnapp = Model.Value<Link>("heroKnapp")
		?? Model.Value<IEnumerable<Link>>("heroKnapp")?.FirstOrDefault();

	// Primär knapp: länken från Umbraco, annars menysidan
	var primarUrl = heroKnapp?.Url ?? menySida?.Url();
	var primarText = heroKnapp?.Name ?? "Se menyn";
	var primarTarget = heroKnapp?.Target;

	// ---- Dagens öppettider från "Öppettider & kontakt" ----
	// Inkl. avvikande tider
	var dagensTider = CafeBlixten.Helpers.Oppettider.TiderIdag(kontaktSida, CafeBlixten.Helpers.Oppettider.NuISverige());

	string? idagText = null;
	if (dagensTider != null)
	{
		idagText = dagensTider.Stangt
			? "Idag har vi stängt"
			: $"Idag öppet {dagensTider.Oppnar}–{dagensTider.Stanger}";

		// T.ex. "(höstlov)"
		if (!string.IsNullOrWhiteSpace(dagensTider.Namn))
		{
			idagText += $" ({dagensTider.Namn.ToLower(svenska)})";
		}
	}

	// ---- Innehåll som hämtas automatiskt från sidorna under Hem ----
	var allaUndersidor = Model.Descendants().ToList();

	var veckansFika = allaUndersidor
		.FirstOrDefault(x => x.ContentType.Alias == "veckansFika");

	var kommandeEvent = allaUndersidor
		.Where(x => x.ContentType.Alias == "event")
		.Where(x => x.Value<DateTime?>("datum") >= DateTime.Today)
		.OrderBy(x => x.Value<DateTime?>("datum"))
		.ToList();

	var senasteNyheter = allaUndersidor
		.Where(x => x.ContentType.Alias == "nyttHosOss")
		.OrderByDescending(x => x.Value<DateTime?>("datum"))
		.ToList();

	// "På gång": kommande evenemang först, sedan de senaste nyheterna, max tre kort
	var pagang = kommandeEvent
		.Select(x => new
		{
			Sida = x,
			Etikett = "Evenemang",
			Rubrik = x.Value<string>("namn"),
			Text = x.Value<string>("beskrivning"),
			Datum = x.Value<DateTime?>("datum"),
			DatumFormat = "d MMMM, 'kl.' HH:mm"
		})
		.Concat(senasteNyheter.Select(x => new
		{
			Sida = x,
			Etikett = "Nyhet",
			Rubrik = x.Value<string>("rubrik"),
			Text = x.Value<string>("text"),
			Datum = x.Value<DateTime?>("datum"),
			DatumFormat = "d MMMM yyyy"
		}))
		.Take(3)
		.ToList();

	var adress = hittaOss?.Value<string>("adress");
}

<div class="startsida">

	@* ================= HERO ================= *@
	<section class="hero startsida-hero" aria-labelledby="startsida-rubrik">
		<div class="hero-text">
			<h1 id="startsida-rubrik">@(heroRubrik ?? Model.Name)</h1>

			@if (!string.IsNullOrWhiteSpace(heroIngress))
			{
				<p class="hero-ingress">@heroIngress</p>
			}

			<div class="cluster">
				@if (primarUrl != null)
				{
					<a class="knapp" href="@primarUrl" target="@primarTarget">@primarText</a>
				}
				@if (hittaOss != null)
				{
					<a class="knapp knapp--sekundar" href="@hittaOss.Url()">Hitta hit</a>
				}
			</div>

			@if (idagText != null)
			{
				<p class="startsida-idag">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
					@idagText
				</p>
			}
		</div>

		<div class="hero-bild">
			<img src="@heroBildUrl" alt="@heroBildAlt" />
		</div>
	</section>

	@* ================= VECKANS FIKA ================= *@
	@if (veckansFika != null)
	{
		var fikaBild = veckansFika.Value<MediaWithCrops>("bild");
		// Samma standardbild som på sidan Veckans fika (VeckansFika.cshtml)
		var fikaBildUrl = fikaBild?.GetCropUrl(width: 800);
		var fikaBildAlt = veckansFika.Value<string>("namn");
		if (string.IsNullOrWhiteSpace(fikaBildUrl))
		{
			fikaBildUrl = "/images/cafe-blixten-kanelbullar.png";
			fikaBildAlt = "Kaffe och nybakade kanelbullar";
		}
		var fikaPris = veckansFika.Value<decimal?>("pris");
		var fikaNamn = veckansFika.Value<string>("namn");
		var fikaBeskrivning = veckansFika.Value<string>("beskrivning");

		<section class="startsida-sektion" aria-labelledby="rubrik-fika">
			<article class="news-card startsida-fika">
				<img class="startsida-fika__bild" src="@fikaBildUrl" alt="@fikaBildAlt" />

				<div class="news-card__content">
					<span class="news-card__label" id="rubrik-fika">Veckans fika</span>
					<h2 class="news-card__title">@fikaNamn</h2>
					@if (!string.IsNullOrWhiteSpace(fikaBeskrivning))
					{
						<p class="news-card__description">@fikaBeskrivning</p>
					}
					@if (fikaPris.HasValue)
					{
						<p class="startsida-fika__pris">@fikaPris.Value.ToString("0.##") kr</p>
					}
				</div>
			</article>
		</section>
	}

	@* ================= PÅ GÅNG ================= *@
	@if (pagang.Any())
	{
		<section class="startsida-sektion" aria-labelledby="rubrik-pagang">
			<div class="startsida-sektion__huvud">
				<h2 id="rubrik-pagang">På gång</h2>
				@if (aktuelltSida != null)
				{
					<a class="startsida-sektion__lank" href="@aktuelltSida.Url()">Se allt i @aktuelltSida.Name <span aria-hidden="true">→</span></a>
				}
			</div>

			<ul class="startsida-grid" role="list">
				@foreach (var post in pagang)
				{
					var bild = post.Sida.Value<MediaWithCrops>("bild");

					<li>
						<article class="news-card">
							@if (bild != null)
							{
								<img class="news-card__image" src="@bild.GetCropUrl(width: 600)" alt="" />
							}
							<div class="news-card__content">
								<span class="news-card__label">@post.Etikett</span>
								<h3 class="news-card__title"><a href="@post.Sida.Url()">@post.Rubrik</a></h3>
								@if (post.Datum.HasValue)
								{
									<time class="news-card__date" datetime="@post.Datum.Value.ToString("yyyy-MM-ddTHH:mm")">
										@post.Datum.Value.ToString(post.DatumFormat, svenska)
									</time>
								}
								@if (!string.IsNullOrWhiteSpace(post.Text))
								{
									<p class="news-card__description">@post.Text</p>
								}
							</div>
						</article>
					</li>
				}
			</ul>
		</section>
	}

	@* ================= VÄLKOMMEN IN ================= *@
	@if (hittaOss != null || kontaktSida != null)
	{
		<section class="startsida-besok" aria-labelledby="rubrik-besok">
			<div class="startsida-besok__text">
				<h2 id="rubrik-besok">Välkommen in</h2>
				<p>Slå dig ner med en nybryggd kopp och något gott från disken.</p>
				@if (!string.IsNullOrWhiteSpace(adress))
				{
					<address>@adress</address>
				}
			</div>

			<div class="cluster">
				@if (hittaOss != null)
				{
					<a class="knapp" href="@hittaOss.Url()">Hitta hit</a>
				}
				@if (kontaktSida != null)
				{
					<a class="knapp knapp--ljus" href="@kontaktSida.Url()">Öppettider &amp; kontakt</a>
				}
			</div>
		</section>
	}

</div>
