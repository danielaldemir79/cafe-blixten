{
  "name": "cafe-blixten",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass Styles/main.scss wwwroot/css/main.css --style=compressed --no-source-map",
    "watch:css": "sass Styles/main.scss wwwroot/css/main.css --watch --embed-source-map",
    "build:js": "esbuild wwwroot/js/main.js --minify --outfile=wwwroot/js/main.min.js && esbuild wwwroot/js/galleri.js --minify --outfile=wwwroot/js/galleri.min.js"
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "esbuild": "^0.25.0"
  }
}
